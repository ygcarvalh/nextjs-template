# The origin this app is served from. Everything that needs to know it reads
# this: metadataBase, robots.txt, the sitemap, whether the token cookies are
# Secure and __Host- prefixed, and whether the CSP upgrades requests.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# The sibling fastapi-template, including its version prefix. The browser never
# calls it: server components, server actions and route handlers do.
API_URL=http://127.0.0.1:8000/api/v1
API_TIMEOUT_MS=10000

# Optional features reachable in this environment, by name. The settings and
# request-log screens are not in here: they are part of the app. A name left out
# answers 404 and its link leaves the header. Server only, so an unreleased
# feature's name never reaches the browser, and an account can override the list
# for itself from the settings screen.
FEATURE_FLAGS=notes

# Identifies this service in every log line and in Grafana.
SERVICE_NAME=nextjs-template
LOG_LEVEL=info
# json for machines, console for a readable local stream.
LOG_FORMAT=json
# Leave unset in production: the platform collects stdout. Set it locally so
# the shared devstack repository has a file to tail.
# LOG_FILE=$HOME/.local/state/devlogs/nextjs-template.jsonl
# Serve /api/metrics for Prometheus.
METRICS_ENABLED=true
