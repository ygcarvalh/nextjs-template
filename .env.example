# Copy this file before running the app: cp .env.example .env.local
# Every variable below is declared and validated in src/env.ts, which
# next.config.ts imports so an invalid environment fails the build.

# Public origin. The NEXT_PUBLIC_ prefix is required: Next only inlines that
# prefix into the client bundle, and @t3-oss/env-nextjs enforces it.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Signs the session cookie. Minimum 32 characters.
# Generate one per environment: openssl rand -base64 32
SESSION_SECRET=dev-only-placeholder-replace-before-deploying

# The seeded demo account. src/features/auth/server/cookie-session.ts is a
# development adapter; replacing it with a real identity provider retires
# both of these variables.
AUTH_DEMO_EMAIL=demo@example.com
AUTH_DEMO_PASSWORD=demo-password

# Identifies this service in every log line and in Grafana.
SERVICE_NAME=nextjs-template
LOG_LEVEL=info
# json for machines, console for a readable local stream.
LOG_FORMAT=json
# Leave unset in production: the platform collects stdout. Set it locally so
# Grafana Alloy has a file to tail.
# LOG_FILE=logs/web.jsonl
# Serve /api/metrics for Prometheus.
METRICS_ENABLED=true
