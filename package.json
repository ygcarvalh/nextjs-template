{
  "name": "nextjs-template",
  "version": "1.1.0",
  "private": true,
  "description": "A Next.js starter with public and private route groups, a replaceable auth seam, and a test suite that gates the build.",
  "license": "MIT",
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=22.13.0",
    "pnpm": ">=11"
  },
  "scripts": {
    "dev": "next dev",
    "dev:logs": "mkdir -p ${DEV_LOG_DIR:-$HOME/.local/state/devlogs} && LOG_FORMAT=json next dev 2>&1 | awk -v out=\"${DEV_LOG_DIR:-$HOME/.local/state/devlogs}/${SERVICE_NAME:-$npm_package_name}.jsonl\" '{ print; if ($0 ~ /^{/) { print >> out; fflush(out) } }'",
    "build": "next build",
    "start": "next start",
    "start:logs": "mkdir -p ${DEV_LOG_DIR:-$HOME/.local/state/devlogs} && next start 2>&1 | tee -a ${DEV_LOG_DIR:-$HOME/.local/state/devlogs}/${SERVICE_NAME:-$npm_package_name}.jsonl",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "verify": "pnpm typecheck && pnpm lint && pnpm test:coverage && pnpm build",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,json,jsonc,md}": "biome check --write --no-errors-on-unmatched"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@prometheus-io/client": "^0.16.1",
    "@t3-oss/env-nextjs": "^0.13.11",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.44.0",
    "next": "16.3.4",
    "next-themes": "^0.4.6",
    "pino": "^10.3.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/jest-axe": "^3.5.9",
    "@types/node": "^22.20.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "5.0.5",
    "husky": "^9.1.7",
    "jest-axe": "^11.0.0",
    "jsdom": "^30.1.3",
    "lint-staged": "^17.6.0",
    "pino-pretty": "^13.2.0",
    "shadcn": "^4.22.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
